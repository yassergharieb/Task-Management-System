    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has dashboard counters', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.total_projects).to.be.a('number');",
                  "    pm.expect(json.data.active_projects).to.be.a('number');",
                  "    pm.expect(json.data.total_tasks).to.be.a('number');",
                  "    pm.expect(json.data.completed_tasks).to.be.a('number');",
                  "    pm.expect(json.data.pending_tasks).to.be.a('number');",
                  "    pm.expect(json.data.overdue_tasks).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/dashboard",
